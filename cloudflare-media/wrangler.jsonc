// Kho nhạc thư viện của trang Slide cưới: Worker CHỈ phục vụ file tĩnh (không có `main`) ở
// media.cuoixinh.com, dùng chung cho mọi môi trường. Đẩy bằng `npm run deploy:media` — luôn
// chỉ rõ file này: chạy wrangler trần ở gốc repo là nó đọc wrangler.jsonc của SITE CHÍNH.
// File nhạc nằm ở public/songs/ trên máy (git bỏ qua), wrangler đọc file trên máy.
// Thêm bài: chép file vào public/songs/, thêm một mục vào public/library.json, deploy.
{
  "$schema": "../cloudflare-worker/node_modules/wrangler/config-schema.json",
  "name": "cuoixinh-media",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "none"
  },
  "routes": [{ "pattern": "media.cuoixinh.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
