{
  "name": "cuoixinh-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:css && npm run build:themes",
    "build:css": "tailwindcss -c ./tailwind.config.js -i ./styles/tailwind-src.css -o ./styles/build.css --minify",
    "build:themes": "tailwindcss -c ./tailwind.themes.config.js -i ./styles/themes-src.css -o ./styles/themes.css --minify",
    "watch:css": "tailwindcss -c ./tailwind.config.js -i ./styles/tailwind-src.css -o ./styles/build.css --watch",
    "watch:themes": "tailwindcss -c ./tailwind.themes.config.js -i ./styles/themes-src.css -o ./styles/themes.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
