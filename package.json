{
  "name": "cuoixinh-web",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "npm run build:css && npm run build:themes",
    "build:css": "tailwindcss -c ./tailwind.config.js -i ./styles/tailwind-src.css -o ./styles/build.css --minify",
    "build:themes": "tailwindcss -c ./tailwind.themes.config.js -i ./styles/themes-src.css -o ./styles/themes.css --minify",
    "watch:css": "tailwindcss -c ./tailwind.config.js -i ./styles/tailwind-src.css -o ./styles/build.css --watch",
    "watch:themes": "tailwindcss -c ./tailwind.themes.config.js -i ./styles/themes-src.css -o ./styles/themes.css --watch",
    "deploy:functions": "bash scripts/deploy-functions.sh",
    "deploy:functions:staging": "bash scripts/deploy-functions.sh --staging",
    "deploy:functions:all": "bash scripts/deploy-functions.sh --all",
    "check:palette": "node scripts/check-theme-palette.mjs",
    "check:palette-contrast": "node scripts/check-palette-contrast.mjs",
    "deploy:public": "node scripts/deploy-public.mjs",
    "sql:merge": "node scripts/merge-changelogs.mjs"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17",
    "terser": "^5.51.2"
  }
}
